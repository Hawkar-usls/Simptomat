{
  "schema": "janus.simptomat.habitat.v1",
  "artifact_id": "SIMPTOMAT_HABITAT-v1.0",
  "repository": "Hawkar-usls/Simptomat",
  "role": "CONSENT_FIRST_ADAPTIVE_DIFFERENTIAL_DIAGNOSTIC_REASONING_RESEARCH_PROTOTYPE",
  "maturity": "ACTIVE_PROTOTYPE",
  "habitat_link": "../.janus/HABITAT_LINK.json",
  "parent_constellation": "Hawkar-usls/Janus_Genesis@janus/habitat",
  "state_ownership": {
    "owns": [
      "screening protocol definitions",
      "differential-diagnosis candidate state",
      "diagnostic-hypothesis ranking state",
      "support/contradiction/uncertainty ledgers",
      "next-question and next-confirmation-step research logic",
      "pseudonymized consented case records",
      "calibration-development state",
      "screening-specific safety and privacy gates"
    ],
    "does_not_own": [
      "clinically confirmed diagnoses or clinician-of-record authority",
      "participant identity",
      "medical records",
      "treatment authority",
      "emergency-service authority",
      "JANUS global truth authority"
    ]
  },
  "accepted_artifacts": [
    "explicit participant consent",
    "self-reported symptom answers",
    "clinician/reference labels only when separately consented and provenance-bound",
    "screening and diagnostic-reasoning protocol versions",
    "external medical references"
  ],
  "emitted_artifacts": [
    "SCREENING_PATTERN_TERMINAL",
    "DIFFERENTIAL_DIAGNOSIS_RANKING",
    "DIAGNOSTIC_HYPOTHESIS",
    "SUPPORT_CONTRADICTION_UNCERTAINTY_LEDGER",
    "NEXT_BEST_QUESTION",
    "NEXT_BEST_CONFIRMATION_STEP",
    "ESCALATION_RECOMMENDATION",
    "PSEUDONYMIZED_CASE_RECORD",
    "CALIBRATION_DEVELOPMENT_RECEIPT"
  ],
  "authority_ceiling": {
    "may_form_diagnostic_hypotheses": true,
    "may_rank_disease_candidates": true,
    "may_suggest_confirmation_steps": true,
    "clinical_diagnostic_authority": false,
    "treatment_authority": false,
    "emergency_triage_substitute": false,
    "contact_or_monitor_participant": false,
    "external_effect_default": "DENY"
  },
  "routing_rules": [
    "DIAGNOSTIC_HYPOTHESIS != CLINICALLY_CONFIRMED_DIAGNOSIS",
    "RANKING != CERTAINTY",
    "MODEL_SCORE != CLINICAL_PROBABILITY_UNLESS_CALIBRATED",
    "SUGGESTED_TEST != MEDICAL_ORDER",
    "CONSENT_REQUIRED_BEFORE_PERSISTENCE",
    "IDENTITY_DATA_DEFAULT_DENY",
    "UNCERTAIN_MUST_REMAIN_UNCERTAIN",
    "URGENT_SAFETY_SIGNAL_OVERRIDES_RESEARCH_FLOW",
    "CLINICAL_REFERENCE_LABEL_REQUIRES_SEPARATE_PROVENANCE",
    "HABITAT_LINK != COMMAND_AUTHORITY"
  ],
  "registry_bridge": {
    "target": "Hawkar-usls/janus-meta-registry",
    "purpose": "provenance, diagnostic-reasoning architecture, calibration history, negative/uncertain result preservation",
    "rule": "REGISTRY_PRESENCE != MEDICAL_TRUTH"
  },
  "failure_terminals": [
    "CONSENT_MISSING",
    "DATA_MINIMIZATION_FAILED",
    "EVIDENCE_INSUFFICIENT",
    "SCREENING_INCONCLUSIVE",
    "DIFFERENTIAL_UNRESOLVED",
    "URGENT_MEDICAL_ESCALATION",
    "REFERENCE_LABEL_MISSING",
    "CALIBRATION_METRICS_BLOCKED"
  ]
}
